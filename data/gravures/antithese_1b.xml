            <figDesc>
              <title type="titre_gravure">Le pape refuse l'entrée d'une ville à l'empereur</title>
              <title type="titre_courant">Mais le Pape par force le faict sien.</title>
              <title type="manchette">Sed presul suscipit urbes. </title>
              
              <dim unit="mm">116 x 96</dim>
              <locus type="page">[14]</locus>
              <objectType>gravure sur bois</objectType>
              
              <bibl source="http://dx.doi.org/10.3931/e-rara-12688">
                <title type="titre_ouvrage">Faitz</title>
